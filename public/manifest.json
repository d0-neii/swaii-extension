{
  "manifest_version": 3,
  "name": "Swaii",
  "version": "1.0.2",
  "description": "마우스 제스처만으로 웹을 제어하는, 개인화된 브라우징 자동화 도구",
  "icons": {
    "128": "icon-128.png"
  },
  "permissions": [
    "identity",
    "storage"
  ],
  "host_permissions": [
    "https://www.notion.so/*",
    "https://www.youtube.com/*",
    "https://chrome.google.com/*",
    "https://www.google.com/*"
  ],
  "oauth2": {
    "client_id":"827087380066-sl0dfcfj0li36j8b4gq38i1v8hvh8i36.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/userinfo.profile",
      "https://www.googleapis.com/auth/userinfo.email"
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Swaii",
    "default_popup": "popup.html"
  }
}
